# Copy this file to .env and fill in your values.
# cp .env.example .env

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONNECTIONS
#
# Each database is declared in config/databases.json with a "name", "type",
# "env_prefix", and "description".  Credentials for each entry live here,
# keyed by that entry's env_prefix.
#
# Supported types: mysql | postgresql | mongodb
# At least ONE database must be configured.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Primary database (env_prefix = "DB") ─────────────────────────────────────
# Matches the default entry in config/databases.json.
# DB_TYPE is NOT needed when databases.json exists — the type is declared there.
# Only keep DB_TYPE if you have not yet created databases.json (legacy fallback).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chatbot_db
# DB_TYPE=mysql    ← legacy only, remove once databases.json is configured

# ── Second database: PostgreSQL example (env_prefix = "PG_DB") ───────────────
# Add to databases.json:
#   { "name": "analytics_db", "type": "postgresql", "env_prefix": "PG_DB",
#     "description": "Analytics — events, sessions" }
# PG_DB_HOST=localhost
# PG_DB_PORT=5432
# PG_DB_USER=postgres
# PG_DB_PASSWORD=your_pg_password
# PG_DB_NAME=analytics
# PG_DB_SCHEMA=public          # optional: restricts to this schema

# ── Third database: MongoDB example (env_prefix = "MONGO") ───────────────────
# Add to databases.json:
#   { "name": "logs_db", "type": "mongodb", "env_prefix": "MONGO",
#     "description": "App logs and user activity events" }
# MONGO_URI=mongodb://localhost:27017    # full URI wins if set (Atlas / replica sets)
#   — OR use individual fields —
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_USER=                            # leave blank if no auth
# MONGO_PASSWORD=
# MONGO_NAME=app_logs                    # the database name (not a collection)

# ── Adding more databases ─────────────────────────────────────────────────────
# 1. Add an entry to config/databases.json  (name, type, env_prefix, description)
# 2. Add table names  →  config/dbs/<name>/tables.json      (SQL)
#             or collection names  →  config/dbs/<name>/collections.json  (Mongo)
# 3. Add credentials here using the same env_prefix + _HOST/_PORT/_USER/etc.
# 4. Restart the app — columns and FK relationships are auto-synced at startup,
#    or trigger manually via the "Sync Schema" admin button.


# ═══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDER
# ═══════════════════════════════════════════════════════════════════════════════

# Pick a provider and install its requirements file once:
#   pip install -r requirements-ollama.txt
#   pip install -r requirements-openai.txt
#   pip install -r requirements-anthropic.txt
#   pip install -r requirements-groq.txt

LLM_PROVIDER=ollama

# Model name — must match the chosen provider's model identifier:
#   ollama:    llama3.1, mistral, gemma2, ...  (run: ollama pull <model>)
#   openai:    gpt-4o, gpt-4o-mini, ...
#   anthropic: claude-sonnet-4-6, claude-opus-4-7, claude-haiku-4-5-20251001, ...
#   groq:      llama-3.1-70b-versatile, mixtral-8x7b-32768, ...
LLM_MODEL=llama3.1

# API key — required for openai / anthropic / groq; leave blank for ollama.
LLM_API_KEY=

# Base URL — required for ollama; optional for openai-compatible custom endpoints.
LLM_BASE_URL=http://localhost:11434


# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# PDF library directory (drop .pdf files here).
PDF_DIR=./pdfs

# ChromaDB vector store directory (auto-created).
CHROMA_DIR=./chroma_db

# Currency symbol shown before monetary values in the chat UI.
# Examples: $  €  £  ₹  ¥  ₩  ₺  ₦
CURRENCY_SYMBOL=$

# Flask session secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret
